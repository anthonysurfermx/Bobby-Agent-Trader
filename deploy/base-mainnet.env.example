# Base mainnet (8453) — deploy + readiness environment (2026-09-05, round 12c).
# Every PUBLIC / derivable value is filled from the audited manifest
# (contracts/deployments/8453.json), the live Safe and the runbooks. Values marked
# <SECRET> live ONLY in Vercel Production / the operator's shell — never in git.
#   predeploy:  set -a; source deploy/base-mainnet.env.example; set +a; npm run check:mainnet:predeploy
#   dry-run:    (same env) cd contracts && forge script script/DeployBase.s.sol --rpc-url base --sender $DEPLOYER_ADDRESS   # NO --broadcast

# --- Chain / cutover flags ---
PROTOCOL_CHAIN=base
PROTOCOL_WRITE_CHAIN_ID=8453
PROTOCOL_WRITES_ENABLED=false            # true ONLY after handoff + verify + canary + soak
PROTOCOL_CUTOVER_FREEZE=true             # stays true until the mainnet canary passes
VERCEL_ENV=production
BASE_RPC_URL=https://base-rpc.publicnode.com   # replace with the provider endpoint in Vercel (never advertised: BP-12)
BASE_PROTOCOL_DEPLOYMENT_BLOCK=50275770  # current deployment; the redeploy rewrites it from receipts

