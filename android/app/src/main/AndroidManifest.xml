<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <queries>
        <intent><action android:name="android.speech.RecognitionService" /></intent>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.intent.action.VIEW" /><data android:scheme="https" /></intent>
    </queries>
    <application
        android:label="Bobby"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:theme="@style/Theme.Bobby"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true">
        <provider android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.avatar-share" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/avatar_share_paths" />
        </provider>
        <!-- One instance, ever (singleTask): the activity owns the session, the page and the 1.8 host, and a
             second one on top of a browser tab (a tapped notice, the sign-in callback) would take the glass
             from the first and leave it mute. A link or a notice reaches the one instance through onNewIntent.
             configChanges: the activity is NOT rebuilt for a rotation, a fold, split screen, the system's
             font size or its dark theme. Compose and the page lay themselves out again; a rebuild would
             close the open sheet, drop a thesis being written and cancel a review already sent. -->
        <activity android:name=".MainActivity" android:exported="true" android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|fontScale|density|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="bobby" android:host="auth" android:path="/callback" />
            </intent-filter>
            <!-- 1.8: an invitation link (https://bobbyprotocol.xyz/i/CODE) opens the app, which keeps the code
                 until an account can accept it (v18/invite). Android 12 and later open these links here by
                 themselves only once the site's /.well-known/assetlinks.json names this package with its
                 signing certificate. Before that the filter is already live: Android 8 to 11 list Bobby in
                 "Open with", a person can turn the links on under "Open by default", and any app can start
                 the activity with such a link. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="bobbyprotocol.xyz" />
                <data android:host="www.bobbyprotocol.xyz" />
                <data android:pathPrefix="/i/" />
            </intent-filter>
        </activity>
    </application>
</manifest>
