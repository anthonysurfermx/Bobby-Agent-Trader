# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OKX DEX Aggregator
OKX_API_KEY=your-api-key
OKX_SECRET_KEY=your-secret-key
OKX_PASSPHRASE=your-passphrase
OKX_PROJECT_ID=your-project-id

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=your-api-key

# Cron secret (optional, for cron triggers)
CRON_SECRET=your-cron-secret

# Reown (WalletConnect)
VITE_REOWN_PROJECT_ID=your-reown-project-id

# OnchainOS Payments (x402 — reuses OKX_* keys above)
# X Layer mainnet only. Default token: USDT0 0x779ded0c9e1022225f8e0630b35a9b54be713736 (6 decimals).
BOBBY_TREASURY_ADDRESS=0x09a81ff70ddbc5e8b88f168b3eef01384b6cdcea
X402_NETWORK=eip155:196
X402_FACILITATOR_BASE_URL=https://web3.okx.com
X402_SYNC_SETTLE=true
X402_DEFAULT_PRICE_USD=$0.01
# Set to "true" to enable x402 path on api/mcp-bobby.ts (legacy OKB path remains the default until cutover)
X402_ENABLED=false
