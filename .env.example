# Supabase

# Optional Android FCM. Enable only after Firebase IAM, migration and GMS device tests.
# Server-only service-account fields; never put the private key in Android or Git.
BOBBY_FCM_PUSH_ENABLED=false
BOBBY_FCM_PROJECT_ID=
BOBBY_FCM_CLIENT_EMAIL=
BOBBY_FCM_PRIVATE_KEY=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OKX DEX Aggregator
OKX_API_KEY=your-api-key
OKX_SECRET_KEY=your-secret-key
OKX_PASSPHRASE=your-passphrase
OKX_PROJECT_ID=your-project-id

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=your-api-key

# Cron secret (optional, for cron triggers)
CRON_SECRET=your-cron-secret

# Auth for on-chain record mutations (xlayer-record POST, forum-resolve).
# FAIL-CLOSED: if unset, those endpoints refuse mutations with 503.
XLAYER_RECORD_SECRET=your-record-secret
TRADING_API_SECRET=your-dedicated-trading-secret
PROTOCOL_AUTOMATION_SECRET=your-dedicated-protocol-automation-secret
PROTOCOL_CUTOVER_FREEZE=true
# Emergency-only local/preview override. Keep false/unset in Vercel preview.
ALLOW_NON_PROD_XLAYER_WRITES=false
# Set by Vercel automatically; Base mainnet writers require exactly production.
VERCEL_ENV=development

# Protocol chain cutover. Base-family writes require BOTH latch variables and
# a chain-specific recorder key; never reuse the X Layer hot key on mainnet.
# Base is the only protocol chain (2026-09-03). 'xlayer' is rejected for writes.
PROTOCOL_CHAIN=base
PROTOCOL_WRITES_ENABLED=false
PROTOCOL_WRITE_CHAIN_ID=8453
BOBBY_RECORDER_KEY=
BASE_SEPOLIA_RECORDER_KEY=
BASE_RECORDER_KEY=
BASE_RECORDER_ADDRESS=
BASE_SEPOLIA_HARDNESS_SERVICE_PRICE_WEI=
BASE_HARDNESS_SERVICE_PRICE_WEI=

# Mainnet deploy identity, roles and reviewed economic parameters.
DEPLOYER_ADDRESS=
OWNER_SAFE_ADDRESS=
OWNER_SAFE_CODEHASH=
OWNER_SAFE_SINGLETON=
OWNER_SAFE_OWNERS=
BOBBY_ADDRESS=
ALPHA_ADDRESS=
RED_ADDRESS=
CIO_ADDRESS=
RESOLVER_ADDRESS=
ARBITER_ADDRESS=
KEEPER_ADDRESS=
HARDNESS_SCORER_ADDRESS=
RESOLVER_ADDRESSES=
RESOLVER_THRESHOLD=
FEE_MCP_CALL_WEI=
FEE_DEBATE_PER_AGENT_WEI=
MIN_BOUNTY_WEI=
ABSOLUTE_MIN_BOUNTY_WEI=
# Bounty economics set by DeployBase BEFORE the Safe handoff. The deploy script can
# default to the declared owner, but mainnet readiness requires both values explicitly.
BOUNTY_TREASURY_ADDRESS=
CHALLENGE_BOND_WEI=25000000000000
REGISTRATION_STAKE_WEI=
ESCROW_MAX_SIZE_USD=

# Base mainnet deployment — populate from contracts/deployments/8453.json only.
TREASURY_ADDRESS_BASE=
VITE_TREASURY_ADDRESS_BASE=
VITE_TREASURY_ADDRESS_BASE_SEPOLIA=
BASE_RPC_URL=https://mainnet.base.org
# Swap rail (Uniswap V3 on Base). Optional ops brake: lowers the per-ticket cap
# below the code constant (500). It can never raise it.
# BASE_SWAP_MAX_TICKET_USD=100
# Tokenized-stock calldata is OFF unless this is exactly "true" (quotes stay visible).
BASE_STOCK_SWAPS_ENABLED=false
# Optional: narrows (never widens) the code's country allow-list, e.g. MX
# BASE_STOCK_COUNTRY_ALLOWLIST=MX
BASE_AGENT_ECONOMY_ADDRESS=
BASE_BOUNTIES_ADDRESS=
BASE_TRACK_RECORD_ADDRESS=
BASE_HARDNESS_REGISTRY_ADDRESS=
BASE_ORACLE_ADDRESS=
BASE_AGENT_REGISTRY_ADDRESS=
BASE_INTENT_ESCROW_ADDRESS=

# Required after the Base mainnet deployment so history scans start at the
# actual protocol genesis instead of scanning arbitrary chain history.
BASE_PROTOCOL_DEPLOYMENT_BLOCK=0

# Reown (WalletConnect)
VITE_REOWN_PROJECT_ID=your-reown-project-id

# Pyth Hermes / Benchmarks (backend only — el contrato NO habla con Hermes).
# Obligatoria desde 2026-08-18 para las llamadas a hermes.pyth.network.
# Marcar como Sensitive en Vercel. Nunca con prefijo VITE_ (filtraría al bundle).
PYTH_HERMES_API_KEY=your-hermes-api-key

# Bobby app chat — durable quotas are fail-closed on Vercel. Keep this switch
# false in normal operation; setting it true stops new LLM requests immediately.
APP_CHAT_KILL_SWITCH=false
APP_CHAT_FAIL_CLOSED=false
APP_CHAT_DEVICE_DAILY_LIMIT=20
APP_CHAT_IP_DAILY_LIMIT=40
APP_CHAT_GLOBAL_DAILY_LIMIT=2000
APP_CHAT_MAX_TOKENS=450
APP_CHAT_MODEL=gpt-4o-mini
# Set a unique random value in Vercel; it hashes device/IP quota keys at rest.
APP_CHAT_QUOTA_SALT=replace-with-a-random-secret

# Google Play sales stay disabled until store configuration + provider/schema acceptance are complete.
# This flag controls new sales capability, not renewal of already verified production subscriptions.
BOBBY_GOOGLE_PAYMENTS_ENABLED=false
# Optional verified public RevenueCat resource IDs for Android paid-event history recovery.
# No app is chosen automatically. Google product format: subscription_id:base_plan_id.
BOBBY_REVENUECAT_ANDROID_APP_ID=appd6f3bca10f
BOBBY_REVENUECAT_ANDROID_PRODUCT_ID=

# Shared Google/Stripe reservations are prepared, default OFF. Requires the additive migration,
# provider credentials/product mapping, legacy Google/Stripe inventory/drain and installed lifecycle QA.
BOBBY_PURCHASE_RESERVATIONS_ENABLED=false
BOBBY_PURCHASE_LEGACY_CHECKOUTS_DRAINED=false
# Server-only 32-byte hex key for encrypted Google receipt candidates/verified tokens. Never VITE_.
BOBBY_PURCHASE_TOKEN_KEY=
BOBBY_GOOGLE_PUBLISHER_CLIENT_EMAIL=
BOBBY_GOOGLE_PUBLISHER_PRIVATE_KEY=
# Actual Play SKU/base-plan/offer tuples; no products exist yet. Empty catalogue cannot sell.
BOBBY_GOOGLE_PRODUCT_CATALOG=[]
