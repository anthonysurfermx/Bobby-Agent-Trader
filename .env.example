# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OKX DEX Aggregator
OKX_API_KEY=your-api-key
OKX_SECRET_KEY=your-secret-key
OKX_PASSPHRASE=your-passphrase
OKX_PROJECT_ID=your-project-id

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=your-api-key

# Cron secret (optional, for cron triggers)
CRON_SECRET=your-cron-secret

# Auth for on-chain record mutations (xlayer-record POST, forum-resolve).
# FAIL-CLOSED: if unset, those endpoints refuse mutations with 503.
XLAYER_RECORD_SECRET=your-record-secret

# Required after the Base mainnet deployment so history scans start at the
# actual protocol genesis instead of scanning arbitrary chain history.
BASE_PROTOCOL_DEPLOYMENT_BLOCK=0

# Reown (WalletConnect)
VITE_REOWN_PROJECT_ID=your-reown-project-id
