# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# OKX DEX Aggregator
OKX_API_KEY=your-api-key
OKX_SECRET_KEY=your-secret-key
OKX_PASSPHRASE=your-passphrase
OKX_PROJECT_ID=your-project-id

# Claude AI (Anthropic)
ANTHROPIC_API_KEY=your-api-key

# Cron secret (optional, for cron triggers)
CRON_SECRET=your-cron-secret

# Auth for on-chain record mutations (xlayer-record POST, forum-resolve).
# FAIL-CLOSED: if unset, those endpoints refuse mutations with 503.
XLAYER_RECORD_SECRET=your-record-secret
TRADING_API_SECRET=your-dedicated-trading-secret
PROTOCOL_AUTOMATION_SECRET=your-dedicated-protocol-automation-secret
PROTOCOL_CUTOVER_FREEZE=true
# Emergency-only local/preview override. Keep false/unset in Vercel preview.
ALLOW_NON_PROD_XLAYER_WRITES=false
# Set by Vercel automatically; Base mainnet writers require exactly production.
VERCEL_ENV=development

# Protocol chain cutover. Base-family writes require BOTH latch variables and
# a chain-specific recorder key; never reuse the X Layer hot key on mainnet.
PROTOCOL_CHAIN=xlayer
PROTOCOL_WRITES_ENABLED=false
PROTOCOL_WRITE_CHAIN_ID=196
BOBBY_RECORDER_KEY=
BASE_SEPOLIA_RECORDER_KEY=
BASE_RECORDER_KEY=
BASE_RECORDER_ADDRESS=
BASE_SEPOLIA_HARDNESS_SERVICE_PRICE_WEI=
BASE_HARDNESS_SERVICE_PRICE_WEI=

# Mainnet deploy identity, roles and reviewed economic parameters.
DEPLOYER_ADDRESS=
OWNER_SAFE_ADDRESS=
OWNER_SAFE_CODEHASH=
OWNER_SAFE_SINGLETON=
OWNER_SAFE_OWNERS=
BOBBY_ADDRESS=
ALPHA_ADDRESS=
RED_ADDRESS=
CIO_ADDRESS=
RESOLVER_ADDRESS=
ARBITER_ADDRESS=
KEEPER_ADDRESS=
HARDNESS_SCORER_ADDRESS=
RESOLVER_ADDRESSES=
RESOLVER_THRESHOLD=
FEE_MCP_CALL_WEI=
FEE_DEBATE_PER_AGENT_WEI=
MIN_BOUNTY_WEI=
ABSOLUTE_MIN_BOUNTY_WEI=
REGISTRATION_STAKE_WEI=
ESCROW_MAX_SIZE_USD=

# Base mainnet deployment — populate from contracts/deployments/8453.json only.
TREASURY_ADDRESS_BASE=
VITE_TREASURY_ADDRESS_BASE=
VITE_TREASURY_ADDRESS_BASE_SEPOLIA=
BASE_RPC_URL=https://mainnet.base.org
BASE_AGENT_ECONOMY_ADDRESS=
BASE_BOUNTIES_ADDRESS=
BASE_TRACK_RECORD_ADDRESS=
BASE_HARDNESS_REGISTRY_ADDRESS=
BASE_ORACLE_ADDRESS=
BASE_AGENT_REGISTRY_ADDRESS=
BASE_INTENT_ESCROW_ADDRESS=

# Required after the Base mainnet deployment so history scans start at the
# actual protocol genesis instead of scanning arbitrary chain history.
BASE_PROTOCOL_DEPLOYMENT_BLOCK=0

# Reown (WalletConnect)
VITE_REOWN_PROJECT_ID=your-reown-project-id

# Pyth Hermes / Benchmarks (backend only — el contrato NO habla con Hermes).
# Obligatoria desde 2026-08-18 para las llamadas a hermes.pyth.network.
# Marcar como Sensitive en Vercel. Nunca con prefijo VITE_ (filtraría al bundle).
PYTH_HERMES_API_KEY=your-hermes-api-key

# Bobby app chat — durable quotas are fail-closed on Vercel. Keep this switch
# false in normal operation; setting it true stops new LLM requests immediately.
APP_CHAT_KILL_SWITCH=false
APP_CHAT_FAIL_CLOSED=false
APP_CHAT_DEVICE_DAILY_LIMIT=20
APP_CHAT_IP_DAILY_LIMIT=40
APP_CHAT_GLOBAL_DAILY_LIMIT=2000
APP_CHAT_MAX_TOKENS=450
APP_CHAT_MODEL=gpt-4o-mini
# Set a unique random value in Vercel; it hashes device/IP quota keys at rest.
APP_CHAT_QUOTA_SALT=replace-with-a-random-secret
