<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Bobby</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>xyz.bobbyprotocol.bobby</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>bobbyprotocol</string>
			</array>
		</dict>
	</array>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>metamask</string>
		<string>trust</string>
		<string>safe</string>
		<string>zerion</string>
		<string>rainbow</string>
		<string>spot</string>
		<string>okex</string>
		<string>cbwallet</string>
		<string>safepalwallet</string>
		<string>tpoutside</string>
		<string>bnc</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Bobby does not take photos or video. This entry is required only because the wallet-connection library used for QR pairing includes a camera scanner that Bobby never turns on.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>Bobby listens so you can ask about any asset out loud.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>Bobby turns your voice into questions about the markets. Audio is processed by Apple's speech recognition.</string>
	<key>UILaunchScreen</key>
	<dict/>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
	</array>
	<key>UIUserInterfaceStyle</key>
	<string>Dark</string>
</dict>
</plist>
