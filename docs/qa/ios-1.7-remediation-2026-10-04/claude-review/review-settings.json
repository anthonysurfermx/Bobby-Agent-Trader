{
  "model": "claude-opus-5-5",
  "ultracode": true,
  "autoMemoryEnabled": false,
  "hooks": {},
  "enabledPlugins": {},
  "permissions": {
    "defaultMode": "dontAsk",
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Workflow",
      "Write(./review-workflow.js)"
    ],
    "deny": [
      "Bash",
      "Edit",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "mcp__*",
      "Read(./**/.env*)",
      "Read(./**/*.pem)",
      "Read(./**/credentials*)"
    ]
  },
  "workflowSizeGuideline": "small"
}
